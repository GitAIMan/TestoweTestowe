generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ==================== ENUMY ====================

enum UserRole {
  PRACOWNIK
  KIEROWNIK
}

enum OfferStatus {
  ROBOCZA
  WYSLANA
  ZAAKCEPTOWANA
  ODRZUCONA
  WYGASLA
}

enum SectionSelectionMode {
  ALL_INCLUDED
  CHOOSE_X_FROM_Y
}

enum AgendaType {
  WSTEPNA
  FINALNA
}

enum NotificationType {
  KLIENT_ZMIANA_WYBORU
  OFERTA_WYGASLA
  OFERTA_ZAAKCEPTOWANA
  OFERTA_ODRZUCONA
  WIADOMOSC_OD_KLIENTA
}

enum TokenType {
  KLIENT_AGENDA
  KUCHNIA_AGENDA
}

// ==================== KONFIGURACJA HOTELU (singleton) ====================

model Settings {
  id                   String   @id @default(cuid())
  hotelName            String
  logoUrl              String?
  primaryColor         String   @default("#1a56db")
  secondaryColor       String   @default("#f3f4f6")
  contactEmail         String?
  contactPhone         String?
  address              String?
  city                 String?
  postalCode           String?
  nip                  String?
  regulamin            String?  @db.Text
  footerText           String?  @db.Text
  offerExpiryDays      Int      @default(14)
  agendaLockDaysBefore Int      @default(14)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
}

// ==================== UŻYTKOWNICY ====================

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  firstName    String
  lastName     String
  role         UserRole
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  offers                 Offer[]
  agendas                Agenda[]
  contracts              Contract[]
  contractAmendments     ContractAmendment[]
  clientMessages         ClientMessage[]
  clientSelectionChanges ClientSelectionChange[]
  notificationsRead      NotificationRead[]
}

// ==================== POKOJE ====================

model Room {
  id            String   @id @default(cuid())
  name          String
  type          String
  pricePerNight Decimal  @db.Decimal(10, 2)
  description   String?
  isActive      Boolean  @default(true)
  sortOrder     Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  offerRooms OfferRoom[]
}

// ==================== SALE ====================

model Hall {
  id          String   @id @default(cuid())
  name        String
  capacity    Int
  pricePerDay Decimal  @db.Decimal(10, 2)
  description String?
  isActive    Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  reservations HallReservation[]
  offerHalls   OfferHall[]
  offerItems   OfferItem[]
  agendaBlocks AgendaBlock[]
}

model HallReservation {
  id        String   @id @default(cuid())
  hallId    String
  hall      Hall     @relation(fields: [hallId], references: [id])
  offerId   String?
  offer     Offer?   @relation(fields: [offerId], references: [id], onDelete: Cascade)
  date      DateTime @db.Date
  status    String   @default("ZAREZERWOWANA")
  createdAt DateTime @default(now())

  @@unique([hallId, date, status])
  @@index([hallId, date])
  @@index([offerId])
}

// ==================== HIERARCHIA MENU ====================
// OfferType -> Package -> Section -> MenuItem

model OfferType {
  id        String   @id @default(cuid())
  name      String
  isActive  Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  packages Package[]
}

model Package {
  id          String    @id @default(cuid())
  offerTypeId String
  offerType   OfferType @relation(fields: [offerTypeId], references: [id], onDelete: Cascade)
  name        String
  description String?
  price       Decimal?  @db.Decimal(10, 2)
  vatRate     Int?
  isActive    Boolean   @default(true)
  sortOrder   Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  sections      Section[]
  offerPackages OfferPackage[]

  @@index([offerTypeId])
}

model Section {
  id             String               @id @default(cuid())
  packageId      String
  package        Package              @relation(fields: [packageId], references: [id], onDelete: Cascade)
  name           String
  selectionMode  SectionSelectionMode @default(ALL_INCLUDED)
  selectionCount Int?
  price          Decimal?             @db.Decimal(10, 2)
  vatRate        Int?
  isActive       Boolean              @default(true)
  sortOrder      Int                  @default(0)
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  items                   MenuItem[]
  agendaSectionSelections AgendaSectionSelection[]

  @@index([packageId])
}

model MenuItem {
  id          String   @id @default(cuid())
  sectionId   String
  section     Section  @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  name        String
  description String?
  price       Decimal? @db.Decimal(10, 2)
  vatRate     Int?
  isActive    Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  clientSelections AgendaItemSelection[]

  @@index([sectionId])
}

// ==================== OFERTA (składana z klocków) ====================

model Offer {
  id            String      @id @default(cuid())
  createdById   String
  createdBy     User        @relation(fields: [createdById], references: [id])
  clientName    String
  clientEmail   String?
  clientPhone   String?
  clientCompany String?
  eventName     String?
  eventDateFrom DateTime    @db.Date
  eventDateTo   DateTime    @db.Date
  adultsCount   Int
  childrenCount Int         @default(0)
  totalPrice    Decimal     @db.Decimal(12, 2)
  notes         String?     @db.Text
  status        OfferStatus @default(ROBOCZA)
  sentAt        DateTime?
  expiresAt     DateTime?
  respondedAt   DateTime?
  offerSentConfirmedAt DateTime?
  lastItemsChangedAt   DateTime?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  offerRooms       OfferRoom[]
  offerHalls       OfferHall[]
  offerPackages    OfferPackage[]
  offerItems       OfferItem[]
  hallReservations HallReservation[]
  contracts        Contract[]
  agendas          Agenda[]

  @@index([status])
  @@index([createdById])
}

// --- Klocki oferty (junction tables ze snapshotami cen) ---

model OfferRoom {
  id            String  @id @default(cuid())
  offerId       String
  offer         Offer   @relation(fields: [offerId], references: [id], onDelete: Cascade)
  roomId        String
  room          Room    @relation(fields: [roomId], references: [id])
  quantity      Int     @default(1)
  nights        Int     @default(1)
  pricePerNight Decimal @db.Decimal(10, 2)
  notes         String?

  @@index([offerId])
}

model OfferHall {
  id          String   @id @default(cuid())
  offerId     String
  offer       Offer    @relation(fields: [offerId], references: [id], onDelete: Cascade)
  hallId      String
  hall        Hall     @relation(fields: [hallId], references: [id])
  date        DateTime @db.Date
  pricePerDay Decimal  @db.Decimal(10, 2)
  notes       String?

  @@index([offerId])
}

model OfferPackage {
  id            String   @id @default(cuid())
  offerId       String
  offer         Offer    @relation(fields: [offerId], references: [id], onDelete: Cascade)
  packageId     String
  package       Package  @relation(fields: [packageId], references: [id])
  priceSnapshot Decimal? @db.Decimal(10, 2)
  notes         String?
  sortOrder     Int      @default(0)

  @@unique([offerId, packageId])
  @@index([offerId])
}

model OfferItem {
  id          String    @id @default(cuid())
  offerId     String
  offer       Offer     @relation(fields: [offerId], references: [id], onDelete: Cascade)
  day         Int       @default(1)
  date        DateTime? @db.Date
  sortOrder   Int       @default(0)
  name        String
  description String?
  timeFrom    String?
  timeTo      String?
  hallId      String?
  hall        Hall?     @relation(fields: [hallId], references: [id])
  quantity    Int       @default(1)
  unitPrice   Decimal   @db.Decimal(10, 2)
  vatRate     Int       @default(23)
  sourceType  String?
  sourceId    String?

  @@index([offerId])
  @@index([offerId, day, sortOrder])
}

// ==================== UMOWA ====================

model Contract {
  id                String    @id @default(cuid())
  offerId           String
  offer             Offer     @relation(fields: [offerId], references: [id])
  createdById       String?
  createdBy         User?     @relation(fields: [createdById], references: [id])
  clientFullName    String
  clientAddress     String?
  clientNip         String?
  clientPesel       String?
  advanceAmount     Decimal?  @db.Decimal(10, 2)
  advanceDueDate    DateTime?
  paymentTerms      String?   @db.Text
  specialConditions String?   @db.Text
  signedAt          DateTime?
  contractSentConfirmedAt DateTime?
  needsAmendment    Boolean   @default(false)
  totalAtSigning    Decimal?  @db.Decimal(10, 2)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  amendments        ContractAmendment[]
  itemSnapshots     ContractItemSnapshot[]

  @@index([offerId])
}

model ContractAmendment {
  id           String    @id @default(cuid())
  contractId   String
  contract     Contract  @relation(fields: [contractId], references: [id], onDelete: Cascade)
  number       Int
  totalBefore  Decimal   @db.Decimal(10, 2)
  totalAfter   Decimal   @db.Decimal(10, 2)
  resolvedAt   DateTime?
  createdById  String?
  createdBy    User?     @relation(fields: [createdById], references: [id])
  createdAt    DateTime  @default(now())

  itemSnapshots ContractItemSnapshot[]

  @@unique([contractId, number])
  @@index([contractId])
}

model ContractItemSnapshot {
  id           String    @id @default(cuid())
  contractId   String
  contract     Contract  @relation(fields: [contractId], references: [id], onDelete: Cascade)
  amendmentId  String?
  amendment    ContractAmendment? @relation(fields: [amendmentId], references: [id], onDelete: Cascade)
  offerItemId  String?
  day          Int       @default(1)
  date         DateTime? @db.Date
  sortOrder    Int       @default(0)
  name         String
  description  String?
  timeFrom     String?
  timeTo       String?
  hallName     String?
  quantity     Int       @default(1)
  unitPrice    Decimal   @db.Decimal(10, 2)
  vatRate      Int       @default(23)
  sourceType   String?
  sourceId     String?

  @@index([contractId])
  @@index([amendmentId])
}

// ==================== AGENDA ====================

model Agenda {
  id          String     @id @default(cuid())
  offerId     String
  offer       Offer      @relation(fields: [offerId], references: [id])
  createdById String
  createdBy   User       @relation(fields: [createdById], references: [id])
  type        AgendaType
  isLocked    Boolean    @default(false)
  notes       String?    @db.Text
  clientNotifiedAt DateTime?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  blocks                 AgendaBlock[]
  tokens                 AgendaToken[]
  clientMessages         ClientMessage[]
  clientSelectionChanges ClientSelectionChange[]

  @@index([offerId])
}

enum ClientMessageStatus {
  ACCEPTED
  REJECTED
  CALL_BACK
}

model ClientMessage {
  id              String               @id @default(cuid())
  agendaId        String
  agenda          Agenda               @relation(fields: [agendaId], references: [id], onDelete: Cascade)
  content         String               @db.Text
  createdAt       DateTime             @default(now())

  responseStatus  ClientMessageStatus?
  responseReason  String?              @db.Text
  responsePhone   String?
  respondedById   String?
  respondedBy     User?                @relation(fields: [respondedById], references: [id])
  respondedAt     DateTime?

  @@index([agendaId, createdAt])
}

model ClientSelectionChange {
  id                   String               @id @default(cuid())
  agendaId             String
  agenda               Agenda               @relation(fields: [agendaId], references: [id], onDelete: Cascade)
  offerItemId          String
  sectionId            String
  proposedMenuItemIds  String[]
  previousMenuItemIds  String[]
  createdAt            DateTime             @default(now())

  responseStatus  ClientMessageStatus?
  responseReason  String?              @db.Text
  responsePhone   String?
  respondedById   String?
  respondedBy     User?                @relation(fields: [respondedById], references: [id])
  respondedAt     DateTime?

  @@index([agendaId, createdAt])
  @@index([agendaId, responseStatus])
}

model AgendaBlock {
  id          String   @id @default(cuid())
  agendaId    String
  agenda      Agenda   @relation(fields: [agendaId], references: [id], onDelete: Cascade)
  date        DateTime @db.Date
  timeFrom    String
  timeTo      String?
  title       String
  description String?  @db.Text
  hallId      String?
  hall        Hall?    @relation(fields: [hallId], references: [id])
  personCount Int?
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  blockPackages AgendaBlockPackage[]
  equipment     AgendaBlockEquipment[]

  @@index([agendaId])
  @@index([agendaId, date])
}

model AgendaBlockPackage {
  id             String      @id @default(cuid())
  agendaBlockId  String
  agendaBlock    AgendaBlock @relation(fields: [agendaBlockId], references: [id], onDelete: Cascade)
  offerPackageId String
  sortOrder      Int         @default(0)

  @@index([agendaBlockId])
}

model AgendaBlockEquipment {
  id            String      @id @default(cuid())
  agendaBlockId String
  agendaBlock   AgendaBlock @relation(fields: [agendaBlockId], references: [id], onDelete: Cascade)
  name          String
  quantity      Int         @default(1)
  notes         String?

  @@index([agendaBlockId])
}

// ==================== WYBORY KLIENTA ====================

model AgendaSectionSelection {
  id          String    @id @default(cuid())
  agendaId    String
  offerItemId String?
  sectionId   String
  section     Section   @relation(fields: [sectionId], references: [id])
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  items AgendaItemSelection[]

  @@unique([agendaId, offerItemId, sectionId])
  @@index([agendaId])
}

model AgendaItemSelection {
  id                       String                 @id @default(cuid())
  agendaSectionSelectionId String
  agendaSectionSelection   AgendaSectionSelection @relation(fields: [agendaSectionSelectionId], references: [id], onDelete: Cascade)
  menuItemId               String
  menuItem                 MenuItem               @relation(fields: [menuItemId], references: [id])
  selectedAt               DateTime               @default(now())

  @@unique([agendaSectionSelectionId, menuItemId])
  @@index([agendaSectionSelectionId])
}

// ==================== TOKENY PUBLICZNE ====================

model AgendaToken {
  id             String    @id @default(cuid())
  agendaId       String
  agenda         Agenda    @relation(fields: [agendaId], references: [id], onDelete: Cascade)
  token          String    @unique @default(cuid())
  type           TokenType
  expiresAt      DateTime?
  isRevoked      Boolean   @default(false)
  lastAccessedAt DateTime?
  createdAt      DateTime  @default(now())

  @@index([token])
  @@index([agendaId])
}

// ==================== POWIADOMIENIA ====================

model Notification {
  id        String           @id @default(cuid())
  type      NotificationType
  title     String
  message   String
  metadata  Json?
  createdAt DateTime         @default(now())

  reads NotificationRead[]

  @@index([createdAt])
}

model NotificationRead {
  id             String       @id @default(cuid())
  notificationId String
  notification   Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id])
  readAt         DateTime     @default(now())

  @@unique([notificationId, userId])
}
